    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "make",
    "integromat",
    "blueprint",
    "automation",
    "audit",
    "security",
    "workflow",
    "claude"
  ],
  "license": "MIT",
  "author": "Kole Harvey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koleharv/make-audit-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
